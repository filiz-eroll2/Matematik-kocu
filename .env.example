# =======================================================
# Matematik Koçu - Ortam Değişkenleri (Environment Variables)
# =======================================================

# 1. Google Gemini API Anahtarı
# Google AI Studio üzerinden ücretsiz alabilirsiniz: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# 2. Oturum Güvenliği İçin JWT Gizli Anahtarı (Rastgele en az 32 karakter)
JWT_SECRET=matematik_kocu_super_secret_jwt_key_2026_edumints_project

# 3. PostgreSQL Veritabanı Bağlantı URL'i
# Yerel test için boş bırakırsanız gömülü PostgreSQL (PGlite) otomatik devreye girer.
# Vercel / Canlı yayın için: Neon, Supabase veya Vercel Postgres bağlantı dizesini ekleyin.
# Örnek: postgresql://kullanici:sifre@ep-xyz.eu-central-1.aws.neon.tech/matematik_kocu?sslmode=require
DATABASE_URL=
